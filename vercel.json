{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd site && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "site/dist",
  "redirects": [
    {
      "source": "/offline.html",
      "destination": "/offlinefiles.html",
      "permanent": true
    }
  ]
}