---
// Only what the store data supports. Mac and Vision Pro appear only for native builds;
// CarPlay never appears unless the data says so (no app supports it today).
import type { App } from '../lib/apps';
interface Props { app: App; surfaces?: boolean }
const { app, surfaces = true } = Astro.props;
const p = app.platforms, s = app.surfaces;
const items: [string, string][] = [];
if (p.iphone) items.push(['iphone', 'iPhone']);
if (p.ipad) items.push(['ipad', 'iPad']);
if (p.mac === 'native') items.push(['mac', 'Mac']);
if (p.watch) items.push(['watch', 'Apple Watch']);
if (p.vision === 'native') items.push(['vision', 'Apple Vision Pro']);
if (p.android) items.push(['android', 'Android']);
if (p.wearOs) items.push(['wear', 'Wear OS']);
if (surfaces) {
  if (s.widgets) items.push(['widgets', 'Widgets']);
  if (s.liveActivities) items.push(['live-activities', 'Live Activities']);
  if (s.controlCenter) items.push(['control-center', 'Control Center']);
  if (s.siri) items.push(['voice', 'Siri']);
}
---
<ul class="op-chips" aria-label="Works on">
  {items.map(([icon, label]) => (
    <li class="op-chip"><svg aria-hidden="true"><use href={`/assets/ui/platform-icons.svg#${icon}`} /></svg>{label}</li>
  ))}
  {app.iosStatus === 'in-review' && <li class="op-chip op-chip--note">iPhone and iPad version in review</li>}
</ul>
