---
import { apps, shortName } from '../lib/apps';
import { appPageUrl } from '../lib/translations';
import { t, BADGE_LANG } from '../lib/ui';
import DeveloperBadges from './DeveloperBadges.astro';
interface Props { lang?: string }
const { lang = 'en' } = Astro.props;
const s = t(lang);
const current = apps.filter((a) => a.group === 'current');
const half = Math.ceil(current.length / 2);
---
<footer class="op-footer">
  <div class="op-wrap">
    <div class="op-footer__grid">
      <div>
        <h2>ORIENTPRO</h2>
        <ul>
          <li>Lam An Investment and Trade JSC</li>
          <li>info@orlproducts.com</li>
          <li><a href="https://apps.apple.com/us/developer/orientpro-lam-an-investment-trade-jsc/id1614396757">{s.asDev}</a></li>
          <li><a href="https://play.google.com/store/apps/developer?id=ORIENTPRO">{s.gpDev}</a></li>
        </ul>
      </div>
      <div>
        <h2>{s.apps}</h2>
        <ul>{current.slice(0, half).map((a) => <li><a href={appPageUrl(a, lang)}>{shortName(a)}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="op-footer__spacer" aria-hidden="true">&nbsp;</h2>
        <ul>{current.slice(half).map((a) => <li><a href={appPageUrl(a, lang)}>{shortName(a)}</a></li>)}</ul>
      </div>
      <div>
        <h2>{s.company}</h2>
        <ul>
          <li><a href="/apps.html">{s.allApps}</a></li>
          <li><a href="/privacy.html">{s.privacy}</a></li>
          <li><a href="/terms.html">{s.termsService}</a></li>
          <li><a href="/contact.html">{s.contact}</a></li>
        </ul>
      </div>
    </div>
    <DeveloperBadges lang={lang} />
    <p class="op-badges-legal">© {new Date().getFullYear()} ORIENTPRO. {s.legal}</p>
  </div>
</footer>
