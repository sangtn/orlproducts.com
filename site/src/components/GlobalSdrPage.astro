<script is:inline define:vars={{ stations }}>
(() => {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const save = navigator.connection && navigator.connection.saveData;
  const load = (v) => { v.querySelectorAll('source[data-src]').forEach((s) => { s.src = s.dataset.src; s.removeAttribute('data-src'); }); v.load(); };

  // Hero device video: only on wide screens without reduced motion or data saver
  const hero = document.querySelector('[data-hero]');
  if (hero && !reduce && !save && matchMedia('(min-width: 720px)').matches) { load(hero); hero.play().catch(() => {}); }

  // Feature clips: load and play while on screen
  const autos = document.querySelectorAll('[data-auto]');
  if (!reduce && !save && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target;
      if (e.isIntersecting) { if (v.querySelector('source[data-src]')) load(v); v.play().catch(() => {}); } else v.pause();
    }), { rootMargin: '120px 0px' });
    autos.forEach((v) => io.observe(v));
  }

  // Tabs (App Preview device, iPhone Duo pose)
  document.querySelectorAll('[role="tablist"]').forEach((list) => {
    const tabs = [...list.querySelectorAll('[role="tab"]')];
    const pick = (t, focus) => {
      tabs.forEach((x) => {
        const on = x === t, panel = document.getElementById(x.getAttribute('aria-controls'));
        x.setAttribute('aria-selected', on); x.tabIndex = on ? 0 : -1; panel.hidden = !on;
        if (!on) panel.querySelectorAll('video').forEach((v) => v.pause());
      });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); pick(tabs[(i + d + tabs.length) % tabs.length], true); }
      });
    });
  });

  // Hero dial: steps through stations heard on GlobalSDR
  const dial = document.querySelector('.sdr-dial');
  if (dial && !reduce) {
    const q = (k) => dial.querySelector(`[data-${k}]`);
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      i = (i + 1) % stations.length;
      const s = stations[i], from = parseFloat(q('freq').textContent), to = parseFloat(s.f), t0 = performance.now();
      dial.classList.add('is-tuning');
      const step = (now) => {
        const k = Math.min(1, (now - t0) / 700), e = 1 - Math.pow(1 - k, 3);
        q('freq').textContent = (from + (to - from) * e).toFixed(2);
        if (k < 1) requestAnimationFrame(step);
        else { q('freq').textContent = s.f; q('mode').textContent = s.m; q('name').textContent = s.n; q('what').textContent = s.w; dial.classList.remove('is-tuning'); }
      };
      requestAnimationFrame(step);
    }, 3600);
  }
})();
</script>

