---
import { t } from '../lib/ui';
interface Props { lang?: string }
const { lang = 'en' } = Astro.props;
const s = t(lang);
---
<header class="op-header">
  <div class="op-wrap op-header__inner">
    <a class="op-header__brand" href="/">
      <img src="/assets/images/favicon.png" alt="" width="28" height="28">
      <span>ORIENTPRO</span>
    </a>
    <nav aria-label="Main">
      <a href="/apps.html">{s.allApps}</a>
      <a href="/contact.html">{s.contact}</a>
    </nav>
  </div>
</header>
