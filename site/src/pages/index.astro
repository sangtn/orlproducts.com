---
// Homepage (/). Replaces the old WordPress export; every app and support link comes from the app data.
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import { apps, shortName, pageUrl } from '../lib/apps';

const site = Astro.site!.origin;
const current = apps.filter((a) => a.group === 'current');
const legacy = apps.filter((a) => a.group === 'legacy');
const featured = [...current].sort((a, b) => Number(b.priority) - Number(a.priority) || (b.appStore?.updated ?? '').localeCompare(a.appStore?.updated ?? '')).slice(0, 6);
const onAppStore = apps.filter((a) => a.appStore).length;
const onWatch = apps.filter((a) => a.platforms.watch).length;
const onPlay = apps.filter((a) => a.platforms.android).length;
const languages = new Set(apps.flatMap((a) => a.appStore?.languages ?? [])).size;

const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': `${site}/#org`, name: 'ORIENTPRO',
      legalName: 'LA Investment and Trade Joint Stock Company', alternateName: 'ORIENTPRO – LA INVESTMENT & TRADE., JSC',
      url: `${site}/`, logo: `${site}/assets/images/favicon.png`, email: 'info@orlproducts.com',
      sameAs: ['https://apps.apple.com/us/developer/orientpro-lam-an-investment-trade-jsc/id1614396757', 'https://play.google.com/store/apps/developer?id=ORIENTPRO'],
    },
    { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'ORIENTPRO', publisher: { '@id': `${site}/#org` }, inLanguage: 'en' },
  ],
};

// Plain links to every app page and policy, kept for App Store and Play reviewers (and the 404 page's #app-directory link)
const directory = apps.map((a) => ({
  name: a.name,
  links: [
    ['Overview', a.generatePage ? pageUrl(a) : a.web.landing],
    ['Privacy', a.web.privacy],
    ['Terms', a.web.terms],
    ['Support', a.web.support],
  ].filter(([, h]) => h) as [string, string][],
})).filter((d) => d.links.length);
---
<Base
  title="ORIENTPRO — Apps for iPhone, iPad, Mac, Apple Watch and Android"
  description="ORIENTPRO (LA Investment & Trade JSC) builds apps for iPhone, iPad, Mac, Apple Watch, Apple Vision Pro and Android: VizMath, Raykin, PaddlePilot and more."
  path="/"
  jsonLd={[orgLd]}
>
  <div class="op-wrap">
    <section class="op-hero op-home-hero">
      <p class="op-eyebrow">ORIENTPRO · LA Investment and Trade JSC</p>
      <h1>We put our soul into every product we make.</h1>
      <p class="op-lead">Apps for iPhone, iPad, Mac, Apple Watch, Apple Vision Pro and Android, made by a small team that cares about every detail.</p>
      <div class="op-links">
        <a class="op-button op-button--primary" href="/apps.html">Browse all {apps.length} apps</a>
        <a class="op-button op-button--secondary" href="https://apps.apple.com/us/developer/orientpro-lam-an-investment-trade-jsc/id1614396757">App Store</a>
        <a class="op-button op-button--secondary" href="https://play.google.com/store/apps/developer?id=ORIENTPRO">Google Play</a>
      </div>
      <dl class="op-stats">
        <div><dt>On the App Store</dt><dd>{onAppStore} apps</dd></div>
        <div><dt>With an Apple Watch app</dt><dd>{onWatch}</dd></div>
        <div><dt>On Google Play</dt><dd>{onPlay}</dd></div>
        <div><dt>Languages across our apps</dt><dd>{languages}</dd></div>
      </dl>
    </section>

    <section class="op-section" aria-labelledby="new">
      <h2 id="new">New and featured</h2>
      <div class="op-appgrid">{featured.map((a) => <AppCard app={a} />)}</div>
    </section>

    <section class="op-section" aria-labelledby="what">
      <h2 id="what">What we do</h2>
      <div class="op-pillars">
        <div><h3>Free to download</h3><p>Every app is free to download on the App Store and Google Play. Some offer optional Pro features through in-app purchase.</p></div>
        <div><h3>Built for the whole device</h3><p>Our apps reach past the phone: {onWatch} have an Apple Watch app, and many add widgets, Live Activities and Control Center controls.</p></div>
        <div><h3>Continuous improvement</h3><p>We update our apps regularly to improve what they do and how they feel, and we read every message sent to info@orlproducts.com.</p></div>
      </div>
    </section>

    <section class="op-section" aria-labelledby="current">
      <h2 id="current">All current apps</h2>
      <div class="op-appgrid">{current.map((a) => <AppCard app={a} />)}</div>
    </section>

    <section class="op-section" aria-labelledby="earlier">
      <h2 id="earlier">Earlier apps</h2>
      <div class="op-appgrid">{legacy.map((a) => <AppCard app={a} />)}</div>
    </section>

    <section class="op-section" id="app-directory" aria-labelledby="directory">
      <h2 id="directory">Apps, privacy and support</h2>
      <p>Every app with its privacy policy, terms of use and support page. General policies: <a href="/privacy.html">Privacy Policy</a> · <a href="/terms.html">Terms of Service</a> · <a href="/contact.html">Contact</a>.</p>
      <ul class="op-directory">
        {directory.map((d) => (
          <li><strong>{d.name}</strong><span>{d.links.map(([label, href], i) => <>{i > 0 && ' · '}<a href={href}>{label}</a></>)}</span></li>
        ))}
      </ul>
    </section>

    <section class="op-section" aria-labelledby="community">
      <h2 id="community">Join the community</h2>
      <p>Questions, ideas and early news about our apps: join the ORIENTPRO group on <a href="https://t.me/+MF4aYRoVeEJlMTVl">Telegram</a>, or write to info@orlproducts.com.</p>
    </section>
  </div>
</Base>
