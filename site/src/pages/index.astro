---
// Homepage (/). Everything comes from the app data via lib/home.ts:
// an icon wall of every app, tinted feature panels with real screens, an icon grid of current and earlier apps,
// and the plain #app-directory that the 404 page and store reviewers rely on.
import Base from '../layouts/Base.astro';
import PlatformChips from '../components/PlatformChips.astro';
import HomeDirectory from '../components/HomeDirectory.astro';
import DeveloperBadges from '../components/DeveloperBadges.astro';
import { site, apps, current, legacy, featured, stats, cleanShot, poster, frameFor, pageUrl, shortName, TELEGRAM } from '../lib/home';
import '../styles/home.css';

const wall = [...apps].sort((a, b) => a.slug.localeCompare(b.slug));
---
<Base
  title="ORIENTPRO — Apps for iPhone, iPad, Mac, Apple Watch and Android"
  description="ORIENTPRO (LA Investment & Trade JSC) builds apps for iPhone, iPad, Mac, Apple Watch, Apple Vision Pro and Android: VizMath, Raykin, PaddlePilot and more."
  path="/"
  jsonLd={[site(Astro.site!.origin)]}
>
  <div class="op-wrap">
    <section class="home-hero">
      <div class="home-hero__copy">
        <p class="op-eyebrow">ORIENTPRO · LA Investment and Trade JSC</p>
        <h1>We put our soul into every product we make.</h1>
        <p class="op-lead">Apps for iPhone, iPad, Mac, Apple Watch, Apple Vision Pro and Android, made by a small team that cares about every detail.</p>
        <div class="home-hero__actions">
          <a class="op-button op-button--primary" href="/apps.html">Browse all {stats.total} apps</a>
          <DeveloperBadges />
        </div>
        <dl class="home-stats">
          <div><dd>{stats.onAppStore}</dd><dt>on the App Store</dt></div>
          <div><dd>{stats.onPlay}</dd><dt>on Google Play</dt></div>
          <div><dd>{stats.onWatch}</dd><dt>with Apple Watch</dt></div>
          <div><dd>{stats.languages}</dd><dt>languages</dt></div>
        </dl>
      </div>
      <ul class="home-wall" aria-label="Our apps">
        {wall.map((a, i) => (
          <li style={`--i:${i}`} data-app={a.slug}><a href={pageUrl(a)} title={shortName(a)}><img src={`/assets/icons/${a.slug}.png`} alt={shortName(a)} width="80" height="80" fetchpriority={i < 6 ? 'high' : undefined} /></a></li>
        ))}
      </ul>
    </section>

    <section class="home-section" aria-labelledby="new">
      <h2 id="new">New and featured</h2>
      <div class="home-features">
        {featured.map((a) => (
          <a class="home-feature" data-app={a.slug} href={pageUrl(a)}>
            <div class="home-feature__text">
              <img class="op-icon" src={`/assets/icons/${a.slug}.png`} alt="" width="64" height="64" loading="lazy" />
              <p class="home-feature__name">{shortName(a)}</p>
              <p class="home-feature__sub">{a.subtitle ?? a.category}</p>
              <PlatformChips app={a} surfaces={false} />
            </div>
            {cleanShot(a) ? (
              <span class={`home-feature__shot op-device op-device--${frameFor(a)}`}><img src={cleanShot(a)} alt={`${shortName(a)} screen`} width="600" height="1304" loading="lazy" /></span>
            ) : poster(a) && (
              <img class="home-feature__poster" src={poster(a)} alt={`${shortName(a)} on the App Store`} width="600" height="1300" loading="lazy" />
            )}
          </a>
        ))}
      </div>
    </section>

    <section class="home-section" aria-labelledby="current">
      <h2 id="current">All current apps</h2>
      <ul class="home-icons">
        {current.map((a) => (
          <li data-app={a.slug}><a href={pageUrl(a)}><img src={`/assets/icons/${a.slug}.png`} alt="" width="72" height="72" loading="lazy" /><span>{shortName(a)}</span><small>{a.category}</small></a></li>
        ))}
      </ul>
    </section>

    <section class="home-section" aria-labelledby="earlier">
      <h2 id="earlier">Earlier apps</h2>
      <ul class="home-icons home-icons--small">
        {legacy.map((a) => (
          <li data-app={a.slug}><a href={pageUrl(a)}><img src={`/assets/icons/${a.slug}.png`} alt="" width="56" height="56" loading="lazy" /><span>{shortName(a)}</span></a></li>
        ))}
      </ul>
    </section>

    <section class="home-section home-pillars" aria-labelledby="what">
      <h2 id="what">What we do</h2>
      <div class="op-pillars">
        <div><h3>Free to download</h3><p>Every app is free to download on the App Store and Google Play. Some offer optional Pro features through in-app purchase.</p></div>
        <div><h3>Built for the whole device</h3><p>Our apps reach past the phone: {stats.onWatch} have an Apple Watch app, and many add widgets, Live Activities and Control Center controls.</p></div>
        <div><h3>Continuous improvement</h3><p>We update our apps regularly to improve what they do and how they feel, and we read every message sent to info@orlproducts.com.</p></div>
      </div>
    </section>

    <section class="home-community" aria-labelledby="community">
      <h2 id="community">Join the community</h2>
      <p>Questions, ideas and early news about our apps: join the ORIENTPRO group on Telegram, or write to info@orlproducts.com.</p>
      <a class="op-button op-button--primary" href={TELEGRAM}>Join us on Telegram</a>
    </section>

    <HomeDirectory />
  </div>
</Base>
