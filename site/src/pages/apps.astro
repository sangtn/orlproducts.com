---
// /apps.html: every ORIENTPRO app, linked to its page or store listing.
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import DeveloperBadges from '../components/DeveloperBadges.astro';
import { apps, pageUrl } from '../lib/apps';

const site = Astro.site!.origin;
const current = apps.filter((a) => a.group === 'current');
const legacy = apps.filter((a) => a.group === 'legacy');
const watchCount = apps.filter((a) => a.platforms.watch).length;

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Apps by ORIENTPRO',
  numberOfItems: apps.length,
  itemListElement: apps.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.name,
    url: new URL(pageUrl(a), site).href,
  })),
};
---
<Base
  title="All apps by ORIENTPRO for iPhone, iPad, Apple Watch and Android"
  description={`All ${apps.length} ORIENTPRO apps for iPhone, iPad, Mac, Apple Watch and Android, with links to each app's store page, privacy policy and support.`}
  path="/apps.html"
  jsonLd={[listLd]}
>
  <div class="op-wrap">
    <section class="op-hero">
      <p class="op-eyebrow">ORIENTPRO</p>
      <h1>All apps</h1>
      <p class="op-lead">{apps.filter((a) => a.appStore).length} apps on the App Store, {watchCount} of them with an Apple Watch app, and {apps.filter((a) => a.platforms.android).length} on Google Play.</p>
      <DeveloperBadges />
    </section>
    <section class="op-section" aria-labelledby="current">
      <h2 id="current">Current apps</h2>
      <div class="op-appgrid">{current.map((a) => <AppCard app={a} />)}</div>
    </section>
    <section class="op-section" aria-labelledby="earlier">
      <h2 id="earlier">Earlier apps</h2>
      <div class="op-appgrid">{legacy.map((a) => <AppCard app={a} />)}</div>
    </section>
  </div>
</Base>
