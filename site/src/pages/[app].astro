---
// One landing page per app with generatePage: true in apps.manual.json -> /<slug>.html, in the app's own language
import AppPage from '../components/AppPage.astro';
import { apps, type App } from '../lib/apps';

export function getStaticPaths() {
  return apps.filter((a) => a.generatePage).map((app) => ({ params: { app: app.slug }, props: { app } }));
}
const { app } = Astro.props as { app: App };
---
<AppPage app={app} lang={app.contentLang} />
